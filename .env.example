# ========================================================
# ShaderLab — Graphics Demo Playground Configuration
# ========================================================

# --- Backend (server/.env) ---
# Server Port (default: 5000)
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
# Replace with your actual MongoDB Atlas URI:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/shaderlab?retryWrites=true&w=majority
# If MongoDB is not reachable or unconfigured, an intelligent in-memory store is used automatically for seamless testing.
MONGODB_URI=mongodb://127.0.0.1:27017/shaderlab

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# --- Frontend (client/.env) ---
# Base URL for Express REST API (defaults to /api with Vite proxy)
VITE_API_URL=http://localhost:5000/api
